DATABASE_URL="postgresql://caddynote:caddynote@localhost:5433/caddynote"
# Choisir UN profil et s'y tenir (hôte 5432 et Compose 5433 sont deux bases).
# Compose (recommandé avec `docker compose up -d caddynote-db`) : port hôte 5433.
# Hôte seulement (Postgres installé sur la machine) :
# DATABASE_URL="postgresql://user:postgres@localhost:5432/caddynote"
# Optionnel : refuse migrate/seed/boot si l'URL ne colle pas
# (compose = :5433 ou hôte caddynote-db ; host = :5432 ; test = *_test).
# CADDYNOTE_DB_PROFILE="compose"
#
# En `docker compose up`, cette valeur est ignorée : docker-compose.yml
# surcharge DATABASE_URL vers le service `caddynote-db`.
# Base dédiée à `npm test` (server/vitest.config.ts) — jamais DATABASE_URL
# ci-dessus : la suite d'isolation multi-tenant (ORG-004) y crée et supprime
# librement des comptes/établissements. Créer avec `createdb caddynote_test`
# puis `npx tsx scripts/which-db.ts` pour vérifier, ensuite
# `DATABASE_URL=$TEST_DATABASE_URL npx prisma migrate deploy`.
TEST_DATABASE_URL="postgresql://user:postgres@127.0.0.1:5432/caddynote_test"
# Rôle du process : all (défaut, HTTP+jobs) | api (HTTP seul) | worker (crons+pg-boss).
# Staging : overlay docker-compose.staging.yml force api + worker (profile split).
# Plusieurs workers OK grâce au verrou advisory (lib/cronLock.ts).
# Éviter all + worker en parallèle.
CADDYNOTE_PROCESS_ROLE="all"
PORT=4000
JWT_SECRET="change-me"
# Défaut applicatif 12h si vide. Staging/production : plafond max 24h (au-delà → clamp).
JWT_EXPIRES_IN="12h"
# Clients API uniquement : renvoyer le JWT dans le JSON (le navigateur n’en a pas besoin).
# ISSUE_BEARER_IN_BODY="true"
# Ou en-tête X-CaddyNote-Bearer: 1 sans Origin (jamais honoré depuis le navigateur).
CORS_ORIGIN="http://localhost:8080"

# Recette locale uniquement : coupe les intégrations sortantes + MFA assouplie.
# Comptes démo retirés. Bootstrap : BOOTSTRAP_ADMIN_* ; recette : RECETTE_* ci-dessous.
# Pilote / production : laisser à "false" (sinon l’API refuse de démarrer si
# CADDYNOTE_DEPLOYMENT=production|staging, sauf CADDYNOTE_ALLOW_TEST_MODE_IN_PROD=true).
CADDYNOTE_TEST_MODE="false"

# Hébergement réel uniquement (staging/production). Absente en Compose local.
# CADDYNOTE_DEPLOYMENT="production"

# DANGER — ne jamais activer en production. Autorise POST /auth/register
# (tous rôles) pour fixtures / bootstrap hors NODE_ENV=test.
# En production, l’inscription publique est fermée (modèle Pronote :
# comptes créés par l’établissement via POST /users, admissions, import).
# CADDYNOTE_ALLOW_PRIVILEGED_REGISTER="false"
# CADDYNOTE_ALLOW_TEST_MODE_IN_PROD="false"

# Bootstrap one-shot du premier super-admin (base vide, sans admin actif).
# PAS les comptes démo (@caddynote.test / Test1234!). Générer un secret fort :
#   openssl rand -base64 24
# Après connexion : créer le vrai admin + MFA, retirer ces lignes, puis
#   POST /admin/bootstrap/retire
# BOOTSTRAP_ADMIN_EMAIL="vous@votredomaine.ci"
# BOOTSTRAP_ADMIN_PASSWORD=""

# URL publique du frontend (liens dans les e-mails, retours Stripe/CinetPay).
APP_URL="http://localhost:8080"
# URL publique de cette API (notify_url CinetPay notamment).
API_URL="http://localhost:4000"
# SSO OIDC (S4) — redirect URI Azure AD (défaut : {API_URL}/auth/sso/callback)
# SSO_OIDC_REDIRECT_URI="http://localhost:4000/auth/sso/callback"
# Allowlist d’hôtes IdP (optionnel). Si défini, issuerUrl / discovery / token / JWKS
# doivent résoudre vers un de ces hôtes (sous-domaines acceptés). Sinon : HTTPS
# public uniquement — les IP privées / metadata sont toujours refusées.
# SSO_ISSUER_HOST_ALLOWLIST="login.microsoftonline.com,accounts.google.com"

# Optionnel : assistant IA des exercices (génération, correction, aide
# pédagogique). Au moins une clé parmi ANTHROPIC_API_KEY / OPENAI_API_KEY.
# Si aucune : /exercises/ai/* répond 501 ; la création manuelle d’exercices
# reste disponible.
# Priorité : AI_PROVIDER=anthropic|openai — sinon Anthropic si présent, sinon OpenAI.
# AI_PROVIDER="openai"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Stockage fichiers S3-compatible (AWS S3, MinIO, Cloudflare R2…).
# Si absent : repli LOCAL automatique sous server/uploads (ou LOCAL_UPLOAD_DIR)
# pour les pièces d’admission — adapté au dev. /files/* et sauvegardes S3
# restent limités sans bucket.
#
# Préfixes objets (policy IAM à aligner) :
#   Uploads : avatars/ documents/ devoirs/ exercices/ messages/ recus/
#             cours/ inscription/ justificatifs/
#   PDF générés : factures/ bulletins/ releves/ certificats/ attestations/
#                 cartes/ listes/ confirmations/
#   Ops : backups/
#
# Exemple policy IAM (remplacer BUCKET) — moindre privilège par préfixe :
# {
#   "Version": "2012-10-17",
#   "Statement": [
#     {
#       "Sid": "ListOwnPrefixes",
#       "Effect": "Allow",
#       "Action": ["s3:ListBucket"],
#       "Resource": "arn:aws:s3:::BUCKET",
#       "Condition": {
#         "StringLike": {
#           "s3:prefix": [
#             "avatars/*", "documents/*", "devoirs/*", "exercices/*",
#             "messages/*", "recus/*", "factures/*", "bulletins/*",
#             "releves/*", "certificats/*", "attestations/*", "cartes/*",
#             "listes/*", "confirmations/*", "cours/*", "inscription/*",
#             "justificatifs/*", "backups/*"
#           ]
#         }
#       }
#     },
#     {
#       "Sid": "ObjectRW",
#       "Effect": "Allow",
#       "Action": [
#         "s3:GetObject", "s3:PutObject", "s3:DeleteObject",
#         "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"
#       ],
#       "Resource": [
#         "arn:aws:s3:::BUCKET/avatars/*",
#         "arn:aws:s3:::BUCKET/documents/*",
#         "arn:aws:s3:::BUCKET/devoirs/*",
#         "arn:aws:s3:::BUCKET/exercices/*",
#         "arn:aws:s3:::BUCKET/messages/*",
#         "arn:aws:s3:::BUCKET/recus/*",
#         "arn:aws:s3:::BUCKET/factures/*",
#         "arn:aws:s3:::BUCKET/bulletins/*",
#         "arn:aws:s3:::BUCKET/releves/*",
#         "arn:aws:s3:::BUCKET/certificats/*",
#         "arn:aws:s3:::BUCKET/attestations/*",
#         "arn:aws:s3:::BUCKET/cartes/*",
#         "arn:aws:s3:::BUCKET/listes/*",
#         "arn:aws:s3:::BUCKET/confirmations/*",
#         "arn:aws:s3:::BUCKET/cours/*",
#         "arn:aws:s3:::BUCKET/inscription/*",
#         "arn:aws:s3:::BUCKET/justificatifs/*",
#         "arn:aws:s3:::BUCKET/backups/*"
#       ]
#     },
#     {
#       "Sid": "BucketMeta",
#       "Effect": "Allow",
#       "Action": [
#         "s3:GetBucketLocation",
#         "s3:GetEncryptionConfiguration"
#       ],
#       "Resource": "arn:aws:s3:::BUCKET"
#     }
#   ]
# }
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
# Requis pour tout ce qui n'est pas AWS S3 lui-même (MinIO, R2...).
S3_ENDPOINT=""
# "true" requis pour MinIO.
S3_FORCE_PATH_STYLE="false"
# Optionnel : répertoire absolu pour le repli local (défaut : server/uploads).
# LOCAL_UPLOAD_DIR=""

# Chiffrement at-rest applicatif (AES-256-GCM) des objets stockés.
# Obligatoire si CADDYNOTE_DEPLOYMENT=staging|production (sinon l’API refuse de démarrer).
# 64 hex = 32 octets, ou base64 32 octets. Générer : openssl rand -hex 32
# FILE_ENCRYPTION_KEY=""
# Chiffrement côté bucket (SSE) en complément :
# S3_SSE="AES256"
# ou S3_SSE="aws:kms" + S3_SSE_KMS_KEY_ID="arn:aws:kms:..."

# Optionnel : e-mail transactionnel (SMTP générique — SendGrid, Mailgun, SES,
# Resend, Postmark, Gmail…). Requis pour un pilote réaliste (liens de suivi
# admission, reset MDP). Si absent : journalisé côté serveur, pas d’envoi.
# Checklist pilote : SMTP_HOST + SMTP_FROM (+ USER/PASS sauf SMTP_NO_AUTH),
# puis `npx tsx scripts/validate-integrations.ts`.
#
# --- Mailpit (messagerie locale, capture SMTP) ---
#   docker compose -f docker-compose.yml -f docker-compose.mail.yml --profile mail up -d
#   UI : http://localhost:8025
#   Smoke : npm run smoke:mailpit
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_SECURE="false"
# SMTP_NO_AUTH="true"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="CaddyNote Local <noreply@caddynote.local>"
# MAILPIT_UI_URL="http://localhost:8025"
#
# Prod / staging (auth requise) :
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CaddyNote <no-reply@caddynote.app>"
# SMTP_NO_AUTH="false"

# Optionnel : Stripe — abonnement SaaS établissement ↔ SDCREATIV (chap. 23)
# ET paiement par carte pour les frais de scolarité (chap. 16, FIN-003). Si
# absent, les endpoints Stripe répondent 501.
# Sandbox uniquement (sk_test_…). `npm run validate:integrations` refuse
# sk_live_* sauf ALLOW_LIVE_INTEGRATION_KEYS=true (revue SDCREATIV).
# ALLOW_LIVE_INTEGRATION_KEYS="false"
STRIPE_SECRET_KEY=""
# Secret du endpoint webhook Stripe (Dashboard Stripe > Webhooks). Sans lui,
# /subscriptions/webhook répond 501 même si STRIPE_SECRET_KEY est configurée
# — la confirmation de paiement ne doit jamais reposer sur autre chose qu'un
# webhook dont la signature est vérifiée (FIN-005).
# Local : `stripe listen --forward-to localhost:4000/subscriptions/webhook`
STRIPE_WEBHOOK_SECRET=""
# Price IDs sandbox (Dashboard → Products). Appliqués au seed démo (plan Performance).
# Ex. price_1ABC… (mensuel) / price_1DEF… (annuel).
STRIPE_SANDBOX_PRICE_MONTHLY=""
STRIPE_SANDBOX_PRICE_YEARLY=""
# Plan rattaché automatiquement à la création d’établissement / backfill orphelins
# (slug catalogue public : essentiel | performance | reseau). Défaut : performance.
DEFAULT_INSTITUTION_PLAN_SLUG="performance"
# Durée de l’essai créé automatiquement (jours).
DEFAULT_INSTITUTION_TRIAL_DAYS="30"

# Optionnel : Mobile Money via CinetPay (Orange Money, MTN Mobile Money,
# Moov, Wave, carte — une seule intégration). Frais de scolarité (FIN-003)
# et frais de dossier admissions (`POST /admissions/status/:token/pay/cinetpay`).
# Si absent, les endpoints CinetPay répondent 501.
# Sandbox : clés test du dashboard CinetPay (jamais de clés live en pilote).
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""

# Web Push (VAPID) — générer : npx web-push generate-vapid-keys
# Sans ces clés, /push/subscribe répond 501 ; canal push reste in-app.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact mailto: ou https: pour setVapidDetails
# Domaine des identifiants élèves opaques (sans e-mail famille).
# Format : s-{id10}@eleves.caddynote.app — pas de prénom.nom.
STUDENT_LOGIN_DOMAIN="eleves.caddynote.app"

# DESPS / DSC — stub ops. Dry-run local sans envoi tant que le contrat API
# n’est pas branché. DESPS_SYNC_LIVE=true = signal ops seulement.
DESPS_BASE_URL=""
DESPS_API_KEY=""
# DESPS_SYNC_LIVE="false"
# Frais de dossier auto à la création (centimes). Ex. 500000 = 5 000 XOF.
# Priorité : politique établissement (`defaultApplicationFeeCents`) > cette env.
ADMISSION_DEFAULT_FEE_CENTS="0"
ADMISSION_DEFAULT_FEE_CURRENCY="XOF"

# Optionnel : SMS + WhatsApp Business via Twilio (chap. 17, COM-001). Si
# absent, /communications/send répond 501 pour les canaux sms/whatsapp
# (email et push restent utilisables indépendamment).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Numéro Twilio classique, ex. "+15551234567".
TWILIO_SMS_FROM=""
# Numéro WhatsApp Business Twilio, ex. "whatsapp:+14155238886" (le préfixe
# "whatsapp:" est ajouté automatiquement si absent).
TWILIO_WHATSAPP_FROM=""

# PRS-004 : filet de sécurité (cron horaire) pour absences non justifiées
# sans alerte déjà envoyée (imports, bugs). L’alerte principale part
# immédiatement à la saisie d’appel. Défaut : 24h si absent/invalide.
ABSENCE_ALERT_DELAY_HOURS="24"

# Obligatoire hors NODE_ENV=test : Bearer exigé sur GET /metrics.
# Sans cette variable, /metrics répond 401 (sauf suite de tests).
METRICS_TOKEN=""

# Swagger /openapi.json et /docs : masqués en staging/production.
# OPENAPI_DOCS=true uniquement sur un réseau interne si besoin.
# OPENAPI_DOCS=true

# NFR-005/006 : nombre de jours de rétention des sauvegardes sur S3 avant
# suppression automatique (tâche planifiée quotidienne, lib/backup.ts). Sans
# effet si S3 n'est pas configuré (rien à nettoyer côté serveur).
BACKUP_RETENTION_DAYS="30"
# Cron de sauvegarde (défaut quotidien 3h → RPO 24h). Exemple plus serré
# sans PITR : "0 */6 * * *" (toutes les 6h). Documenter BACKUP_RPO_HOURS.
BACKUP_CRON="0 3 * * *"
BACKUP_RPO_HOURS="24"

# Drill restore logique (S2) — base source ≠ prod. Admin URL pour CREATE/DROP DB.
# DRILL_SOURCE_DATABASE_URL="$DATABASE_URL"
# DRILL_ADMIN_DATABASE_URL="postgresql://caddynote:caddynote@localhost:5433/postgres"
# DRILL_KEEP="false"

# PITR staging (S3) — chemins hôte pour overlay docker-compose.pitr.yml
# PITR_WAL_ARCHIVE_PATH="../tmp/pg_wal_archive"
# PITR_BASEBACKUP_PATH="../tmp/pg_basebackups"

# DOC-005 : ClamAV (clamd). Si absent, scan antivirus désactivé (dégradation
# explicite). En compose : service `clamav` → CLAMAV_HOST=clamav.
# Obligatoire si CADDYNOTE_DEPLOYMENT=production (fail-closed uploads + boot).
# Staging Oracle ARM : laisser vide (warning diagnostics) ; x86 : clamav + host.
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# DOC-005 : purge rétention fichiers. Sans `true`, POST /files/purge et le
# cron restent en dry-run (jamais de suppression). Activer seulement après
# dry-run validé (docs/POLITIQUE_CONSERVATION_FICHIERS.md).
FILE_PURGE_ENABLED="false"

# Recette / smoke / pentest-prep (plus de seed démo)
# RECETTE_PASSWORD=""
# RECETTE_ADMIN_EMAIL=""
# RECETTE_SCHOOL_ADMIN_EMAIL=""
# RECETTE_TEACHER_EMAIL=""
# RECETTE_HEAD_TEACHER_EMAIL=""
# RECETTE_STUDENT_EMAIL=""
# RECETTE_PARENT_EMAIL=""
# RECETTE_STAFF_EMAIL=""
# RECETTE_SECRETARY_EMAIL=""
# RECETTE_ACCOUNTANT_EMAIL=""
# RECETTE_SUPERVISOR_EMAIL=""
# Purge d’anciennes démos en base : npm run purge:demo
# Hard wipe STAGING (établissements + comptes école + admissions + devoirs) :
#   1) backup pg_dump
#   2) npm run wipe:staging -- --dry-run
#   3) STAGING_HARD_WIPE_CONFIRM=YES_WIPE_STAGING npm run wipe:staging
# Refuse CADDYNOTE_DEPLOYMENT=production.
