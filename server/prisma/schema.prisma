// ============================================================
// Administration SaaS & abonnements (facturation SDCREATIV <-> établissement)
// ============================================================

model SubscriptionPlan {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  priceMonthly        Decimal   @map("price_monthly")
  priceYearly         Decimal?  @map("price_yearly")
  stripePriceId       String?   @map("stripe_price_id")
  stripeYearlyPriceId String?   @map("stripe_yearly_price_id")
  maxStudents         Int?      @map("max_students")
  maxInstitutions     Int?      @map("max_institutions")
  maxMonthlyReports   Int?      @map("max_monthly_reports")
  storageLimitGb      Int?      @map("storage_limit_gb")
  // SAA-003 : quotas élèves/établissements/rapports/stockage existaient déjà
  // dans le schéma mais n'étaient lus nulle part côté application — jamais
  // appliqués. "Utilisateurs" (personnel/comptes, distinct des élèves) et
  // "SMS" (chap. 17, coût variable par envoi) manquaient carrément de champ.
  maxUsers            Int?      @map("max_users")
  maxSmsPerMonth      Int?      @map("max_sms_per_month")
  // Quota mensuel d'appels générateur IA exercices (`POST /exercises/ai/generate`).
  maxAiPerMonth       Int?      @map("max_ai_per_month")
  features            Json      @default("{}")
  isTrial             Boolean?  @default(false) @map("is_trial")
  isActive            Boolean?  @default(true) @map("is_active")
  sortOrder           Int?      @default(0) @map("sort_order")
  createdAt           DateTime? @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt @map("updated_at")

  subscriptions PremiumSubscription[]

  @@map("subscription_plans")
}

model PremiumSubscription {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                      String    @map("user_id") @db.Uuid
  institutionId               String?   @map("institution_id") @db.Uuid
  planId                      String?   @map("plan_id") @db.Uuid
  plan                        String
  status                      String    @default("active")
  billingCycle                String?   @default("monthly") @map("billing_cycle")
  startsAt                    DateTime  @default(now()) @map("starts_at")
  expiresAt                   DateTime  @map("expires_at")
  trialStartsAt               DateTime? @map("trial_starts_at")
  trialEndsAt                 DateTime? @map("trial_ends_at")
  autoRenew                   Boolean?  @default(true) @map("auto_renew")
  stripeCustomerId            String?   @map("stripe_customer_id")
  stripeSubscriptionId        String?   @map("stripe_subscription_id")
  paymentMethodId             String?   @map("payment_method_id")
  lastPaymentDate             DateTime? @map("last_payment_date")
  nextBillingDate             DateTime? @map("next_billing_date")
  expirationNotificationsSent Json?     @default("[]") @map("expiration_notifications_sent")
  // SAA-004 : suspension graduée — `status` passe de 'active' à 'grace'
  // (avertissement, accès intact) puis 'suspended' (lecture seule, jamais de
  // suppression de données) après le délai de grâce. `suspendedAt` distingue
  // une suspension réelle d'un simple changement de statut administratif.
  suspendedAt                 DateTime? @map("suspended_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  institution StrkInstitution?  @relation(fields: [institutionId], references: [id])
  plan_       SubscriptionPlan? @relation(fields: [planId], references: [id])

  billingHistory            BillingHistory[]
  subscriptionNotifications SubscriptionNotification[]

  @@map("premium_subscriptions")
}

model BillingHistory {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId     String    @map("subscription_id") @db.Uuid
  stripeInvoiceId    String?   @map("stripe_invoice_id")
  amount             Decimal
  currency           String?   @default("EUR")
  status             String
  billingPeriodStart DateTime? @map("billing_period_start")
  billingPeriodEnd   DateTime? @map("billing_period_end")
  paymentDate        DateTime? @map("payment_date")
  invoiceUrl         String?   @map("invoice_url")
  metadata           Json?     @default("{}")
  createdAt          DateTime? @default(now()) @map("created_at")

  subscription PremiumSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_history")
}

model SubscriptionNotification {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId       String    @map("subscription_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  notificationType     String    @map("notification_type")
  daysBeforeExpiration Int?      @map("days_before_expiration")
  sentAt               DateTime? @default(now()) @map("sent_at")
  emailSent            Boolean?  @default(false) @map("email_sent")
  inAppRead            Boolean?  @default(false) @map("in_app_read")
  createdAt            DateTime? @default(now()) @map("created_at")

  subscription PremiumSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         StrkProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription_notifications")
}

// ============================================================
// Finance / facturation établissement ↔ parents (chap. 16, FIN-001 à 008)
// Distinct de PremiumSubscription/BillingHistory ci-dessus qui couvrent
// l'abonnement SaaS établissement ↔ SDCREATIV.
// Montants stockés en entiers (centimes) + code devise — jamais en flottant
// (cf. audit §6 Lot 5). Confirmation de paiement uniquement côté serveur
// après vérification du provider (webhook + appel de contrôle), jamais sur
// la seule foi du retour navigateur (FIN-005).
//
// Grille financière CI (Lot 1+) : catalogues / grilles / templates d'échéancier
// étendent ce module — ne remplacent pas FeeItem / Invoice / PaymentPlan.
// ============================================================

/// Cycle scolaire du référentiel (préscolaire → lycée). Catalogue plateforme.
model StrkEducationCycle {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gradeLevels StrkGradeLevel[]

  @@map("strk_education_cycles")
}

/// Niveau de classe (PS, CP1, 6e…). Mapping manuel depuis StrkClass (Q6).
model StrkGradeLevel {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId      String   @map("cycle_id") @db.Uuid
  code         String   @unique
  label        String
  abbreviation String
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cycle              StrkEducationCycle     @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  classes            StrkClass[]
  feeScheduleItems   StrkFeeScheduleItem[]
  studentFeeAssignments StrkStudentFeeAssignment[]

  @@index([cycleId])
  @@map("strk_grade_levels")
}

/// Type de frais catalogue (plateforme si institutionId null, sinon custom tenant).
model StrkFeeType {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// null = entrée du catalogue plateforme (seed CI) ; sinon type local.
  institutionId String?  @map("institution_id") @db.Uuid
  code          String
  label         String
  category      String
  /// annual | monthly | quarterly | one_time | periodic | configurable
  frequency     String   @default("configurable")
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution      StrkInstitution?      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  feeItems         StrkFeeItem[]
  feeScheduleItems StrkFeeScheduleItem[]

  @@index([institutionId, category])
  @@map("strk_fee_types")
}

/// Version publiée du référentiel national (données État, pas admin CRUD plateforme).
model StrkNationalFeeVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode   String   @map("country_code")
  academicYear  String   @map("academic_year")
  currency      String   @default("XOF")
  version       Int      @default(1)
  /// draft | published | archived
  status        String   @default("draft")
  effectiveFrom DateTime @map("effective_from")
  /// Ex. state_ci — le référentiel n'est pas administré par le super-admin plateforme.
  managedBy     String   @default("state_ci") @map("managed_by")
  source        String?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  rates StrkNationalFeeRate[]

  @@unique([countryCode, academicYear, version])
  @@index([countryCode, academicYear, status])
  @@map("strk_national_fee_versions")
}

model StrkNationalFeeRate {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId     String @map("version_id") @db.Uuid
  cycleCode     String @map("cycle_code")
  /// public | private
  fundingSector String @map("funding_sector")
  feeTypeCode   String @map("fee_type_code")
  amountCents   Int    @map("amount_cents")
  currency      String @default("XOF")

  version StrkNationalFeeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, cycleCode, fundingSector, feeTypeCode])
  @@index([versionId])
  @@map("strk_national_fee_rates")
}

/// Grille tarifaire établissement (versionnable). Workflow DRAFT→VALIDATED→PUBLISHED→ARCHIVED.
model StrkFeeSchedule {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId      String    @map("institution_id") @db.Uuid
  campusId           String?   @map("campus_id") @db.Uuid
  academicYear       String    @map("academic_year")
  name               String
  currency           String    @default("XOF")
  version            Int       @default(1)
  /// draft | validated | published | archived
  status             String    @default("draft")
  effectiveFrom      DateTime? @map("effective_from")
  validatedAt        DateTime? @map("validated_at")
  validatedBy        String?   @map("validated_by") @db.Uuid
  publishedAt        DateTime? @map("published_at")
  publishedBy        String?   @map("published_by") @db.Uuid
  previousVersionId  String?   @map("previous_version_id") @db.Uuid
  createdBy          String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  institution     StrkInstitution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus          StrkCampus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  previousVersion StrkFeeSchedule?     @relation("FeeScheduleVersionChain", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions    StrkFeeSchedule[]    @relation("FeeScheduleVersionChain")
  creator         StrkProfile          @relation("FeeScheduleCreatedBy", fields: [createdBy], references: [id])
  validator       StrkProfile?         @relation("FeeScheduleValidatedBy", fields: [validatedBy], references: [id])
  publisher       StrkProfile?         @relation("FeeSchedulePublishedBy", fields: [publishedBy], references: [id])
  items           StrkFeeScheduleItem[]
  planTemplates   StrkFeePlanTemplate[]
  invoices        StrkInvoice[]
  paymentPlans    StrkPaymentPlan[]
  studentAssignments StrkStudentFeeAssignment[]

  @@index([institutionId, academicYear, status])
  @@index([campusId])
  @@map("strk_fee_schedules")
}

/// Affectation élève → grille publiée (+ options facultatives souscrites).
model StrkStudentFeeAssignment {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId        String    @map("institution_id") @db.Uuid
  studentId            String    @map("student_id") @db.Uuid
  feeScheduleId        String    @map("fee_schedule_id") @db.Uuid
  academicYear         String    @map("academic_year")
  cycleCode            String?   @map("cycle_code")
  gradeLevelId         String?   @map("grade_level_id") @db.Uuid
  /// Codes types facultatifs souscrits (ex. CANTEEN) — JSON string[].
  optionalFeeTypeCodes Json      @default("[]") @map("optional_fee_type_codes")
  /// active | ended
  status               String    @default("active")
  createdBy            String    @map("created_by") @db.Uuid
  endedAt              DateTime? @map("ended_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  institution StrkInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     StrkStudent     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeSchedule StrkFeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Restrict)
  gradeLevel  StrkGradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  creator     StrkProfile     @relation("StudentFeeAssignmentCreatedBy", fields: [createdBy], references: [id])

  @@index([institutionId, academicYear, status])
  @@index([studentId, status])
  @@index([feeScheduleId])
  @@map("strk_student_fee_assignments")
}

model StrkFeeScheduleItem {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeScheduleId   String  @map("fee_schedule_id") @db.Uuid
  feeTypeId       String? @map("fee_type_id") @db.Uuid
  feeTypeCode     String  @map("fee_type_code")
  cycleCode       String? @map("cycle_code")
  gradeLevelId    String? @map("grade_level_id") @db.Uuid
  /// first | renewal | transfer | any
  enrollmentType  String? @map("enrollment_type")
  studentStatus   String? @map("student_status")
  /// state | institution
  feeOrigin       String  @default("institution") @map("fee_origin")
  amountCents     Int     @map("amount_cents")
  currency        String  @default("XOF")
  isMandatory     Boolean @default(true) @map("is_mandatory")
  isRefundable    Boolean @default(false) @map("is_refundable")
  isDiscountable  Boolean @default(true) @map("is_discountable")
  frequency       String  @default("annual")
  sortOrder       Int     @default(0) @map("sort_order")

  feeSchedule  StrkFeeSchedule  @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)
  feeType      StrkFeeType?     @relation(fields: [feeTypeId], references: [id], onDelete: SetNull)
  gradeLevel   StrkGradeLevel?  @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  invoiceLines StrkInvoiceLine[]

  @@index([feeScheduleId])
  @@index([feeTypeCode])
  @@map("strk_fee_schedule_items")
}

/// Template d'échéancier (≠ StrkPaymentPlan élève). Pourcentage ou montant fixe.
model StrkFeePlanTemplate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  feeScheduleId String?  @map("fee_schedule_id") @db.Uuid
  name          String
  currency      String   @default("XOF")
  isActive      Boolean  @default(true) @map("is_active")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution  StrkInstitution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  feeSchedule  StrkFeeSchedule?         @relation(fields: [feeScheduleId], references: [id], onDelete: SetNull)
  creator      StrkProfile              @relation("FeePlanTemplateCreatedBy", fields: [createdBy], references: [id])
  steps        StrkFeePlanTemplateStep[]
  paymentPlans StrkPaymentPlan[]

  @@index([institutionId])
  @@index([feeScheduleId])
  @@map("strk_fee_plan_templates")
}

model StrkFeePlanTemplateStep {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId    String  @map("template_id") @db.Uuid
  label         String
  /// Pourcentage entier 0–100 (null si amountCents renseigné).
  percent       Int?
  amountCents   Int?    @map("amount_cents")
  dueOffsetDays Int?    @map("due_offset_days")
  sortOrder     Int     @default(0) @map("sort_order")

  template StrkFeePlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("strk_fee_plan_template_steps")
}

model StrkFeeItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId  String   @map("institution_id") @db.Uuid
  campusId       String?  @map("campus_id") @db.Uuid
  feeTypeId      String?  @map("fee_type_id") @db.Uuid
  feeTypeCode    String?  @map("fee_type_code")
  /// state | institution
  feeOrigin      String?  @map("fee_origin")
  isMandatory    Boolean  @default(true) @map("is_mandatory")
  isRefundable   Boolean  @default(false) @map("is_refundable")
  isDiscountable Boolean  @default(true) @map("is_discountable")
  frequency      String?  @map("frequency")
  name           String
  description    String?
  amountCents    Int      @map("amount_cents")
  currency       String   @default("XOF")
  academicYear   String?  @map("academic_year")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  institution  StrkInstitution   @relation(fields: [institutionId], references: [id])
  campus       StrkCampus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  feeType      StrkFeeType?      @relation(fields: [feeTypeId], references: [id], onDelete: SetNull)
  invoiceLines StrkInvoiceLine[]

  @@index([institutionId, feeTypeCode])
  @@index([campusId])
  @@map("strk_fee_items")
}

model StrkInvoice {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId      String    @map("institution_id") @db.Uuid
  studentId          String    @map("student_id") @db.Uuid
  invoiceNumber      String    @unique @map("invoice_number")
  status             String    @default("issued") // draft | issued | partially_paid | paid | overdue | cancelled
  totalCents         Int       @map("total_cents")
  paidCents          Int       @default(0) @map("paid_cents")
  currency           String    @default("XOF")
  dueDate            DateTime? @map("due_date")
  issuedAt           DateTime  @default(now()) @map("issued_at")
  createdBy          String    @map("created_by") @db.Uuid
  // FIN : facture générée depuis un échéancier (plan de paiement).
  paymentPlanId      String?   @map("payment_plan_id") @db.Uuid
  // Rang de l'échéance dans le plan (1..N), null si facture hors plan.
  installmentIndex   Int?      @map("installment_index")
  feeScheduleId      String?   @map("fee_schedule_id") @db.Uuid
  feeScheduleVersion Int?      @map("fee_schedule_version")
  /// Instantané tarifaire à l'émission (grille / lignes / devise) — immuable.
  tariffSnapshot     Json?     @map("tariff_snapshot")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  institution      StrkInstitution  @relation(fields: [institutionId], references: [id])
  student          StrkStudent      @relation(fields: [studentId], references: [id])
  createdByProfile StrkProfile      @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  paymentPlan      StrkPaymentPlan? @relation(fields: [paymentPlanId], references: [id])
  feeSchedule      StrkFeeSchedule? @relation(fields: [feeScheduleId], references: [id], onDelete: SetNull)

  lines    StrkInvoiceLine[]
  payments StrkPayment[]
