model StrkInvoiceLine {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId         String  @map("invoice_id") @db.Uuid
  feeItemId         String? @map("fee_item_id") @db.Uuid
  label             String
  amountCents       Int     @map("amount_cents")
  quantity          Int     @default(1)
  // FIN-002 : remise/bourse — `amountCents` reste toujours un montant positif
  // (magnitude), jamais stocké négatif (éviterait de fausser tout code qui
  // suppose des montants positifs ailleurs, ex. Stripe). C'est `lineType`
  // qui détermine si la ligne s'ajoute ou se retranche du total de la
  // facture (POST /finance/invoices).
  lineType          String  @default("fee") @map("line_type") // "fee" | "discount"
  feeTypeCode       String? @map("fee_type_code")
  /// state | institution
  feeOrigin         String? @map("fee_origin")
  feeScheduleItemId String? @map("fee_schedule_item_id") @db.Uuid

  invoice         StrkInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItem         StrkFeeItem?         @relation(fields: [feeItemId], references: [id])
  feeScheduleItem StrkFeeScheduleItem? @relation(fields: [feeScheduleItemId], references: [id], onDelete: SetNull)

  @@index([feeScheduleItemId])
  @@map("strk_invoice_lines")
}

model StrkPayment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId         String    @map("invoice_id") @db.Uuid
  amountCents       Int       @map("amount_cents")
  currency          String    @default("XOF")
  method            String // mobile_money | card | bank_transfer | cash
  status            String    @default("pending") // pending | paid | failed | refunded
  provider          String? // cinetpay | stripe | manual
  providerRef       String?   @unique @map("provider_ref") // transaction_id envoyé au provider
  providerPaymentId String?   @map("provider_payment_id") // id renvoyé par le provider une fois confirmé
  paidAt            DateTime? @map("paid_at")
  paidBy            String?   @map("paid_by") @db.Uuid
  receiptNumber     String?   @unique @map("receipt_number")
  verificationToken String?   @unique @map("verification_token")
  metadata          Json?     @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  invoice       StrkInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paidByProfile StrkProfile? @relation("PaymentPaidBy", fields: [paidBy], references: [id])

  refunds            StrkRefund[]
  bankStatementLines StrkBankStatementLine[]

  @@map("strk_payments")
}

model StrkRefund {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  reason      String?
  refundedBy  String   @map("refunded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  payment           StrkPayment @relation(fields: [paymentId], references: [id])
  refundedByProfile StrkProfile @relation("RefundBy", fields: [refundedBy], references: [id])

  @@map("strk_refunds")
}

// FIN-007 : ligne de relevé bancaire importée pour rapprochement avec les
// paiements enregistrés. Le rapprochement automatique (`lib/bankReconciliation.ts`)
// ne matche que s'il trouve un unique paiement confirmé de même montant dans
// une fenêtre de quelques jours autour de la date de la ligne — en cas
// d'ambiguïté (plusieurs candidats, ou aucun), la ligne reste "unmatched"
// pour un rapprochement manuel plutôt qu'un mauvais matching automatique.
model StrkBankStatementLine {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId    String             @map("institution_id") @db.Uuid
  date             DateTime           @db.Date
  amountCents      Int                @map("amount_cents")
  currency         String             @default("XOF")
  label            String
  externalRef      String?            @map("external_ref")
  status           StrkBankLineStatus @default(unmatched)
  matchedPaymentId String?            @map("matched_payment_id") @db.Uuid
  matchedBy        String?            @map("matched_by") @db.Uuid
  matchedAt        DateTime?          @map("matched_at")
  importedBy       String             @map("imported_by") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")

  institution       StrkInstitution @relation(fields: [institutionId], references: [id])
  matchedPayment    StrkPayment?    @relation(fields: [matchedPaymentId], references: [id])
  matchedByProfile  StrkProfile?    @relation("BankLineMatchedBy", fields: [matchedBy], references: [id])
  importedByProfile StrkProfile     @relation("BankLineImportedBy", fields: [importedBy], references: [id])

  @@map("strk_bank_statement_lines")
}

// ============================================================
// Communication multicanal (chap. 17, COM-001 à 005)
// ============================================================

enum StrkCommChannel {
  email
  sms
  whatsapp
  push // notifications internes existantes (table `notifications`)

  @@map("strk_comm_channel")
}

enum StrkCommStatus {
  queued
  sent
  delivered
  read
  failed

  @@map("strk_comm_status")
}

// COM-002 : modèle de message versionné. Une nouvelle version n'écrase
// jamais l'ancienne (désactivée via `isActive: false`) — l'historique
// complet des libellés envoyés reste consultable.
model StrkMessageTemplate {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Null = modèle global (fourni par défaut, valable pour tout établissement
  // qui n'a pas défini sa propre version pour ce useCase/canal/langue).
  institutionId String?         @map("institution_id") @db.Uuid
  useCase       String          @map("use_case") // ex. "absence_alert", "invoice_due", "welcome"
  channel       StrkCommChannel
  locale        String          @default("fr")
  version       Int             @default(1)
  isActive      Boolean         @default(true) @map("is_active")
  subject       String? // e-mail uniquement
  body          String // "{{variableName}}" remplacé à l'envoi (cf. lib/templates.ts)
  variables     Json            @default("[]") // liste des noms de variables autorisées
  createdBy     String?         @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  institution StrkInstitution?       @relation(fields: [institutionId], references: [id])
  creator     StrkProfile?           @relation("MessageTemplateCreatedBy", fields: [createdBy], references: [id])
  logs        StrkCommunicationLog[]

  @@unique([institutionId, useCase, channel, locale, version])
  @@map("strk_message_templates")
}

// COM-003 : consentement/préférence de canal par utilisateur. Absence de
// ligne = opt-in par défaut (comportement conservé pour ne pas couper la
// communication existante rétroactivement) ; une ligne explicite fait foi.
model StrkCommunicationPreference {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String          @map("profile_id") @db.Uuid
  channel   StrkCommChannel
  optedIn   Boolean         @default(true) @map("opted_in")
  updatedAt DateTime        @updatedAt @map("updated_at")

  profile StrkProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, channel])
  @@map("strk_communication_preferences")
}

// COM-004/005 : traçabilité complète du cycle de vie d'un message envoyé
// (demandé → mis en file → envoyé → livré → lu → échoué) + accusé de
// réception explicite pour les communications critiques.
model StrkCommunicationLog {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId     String?         @map("institution_id") @db.Uuid
  templateId        String?         @map("template_id") @db.Uuid
  // Cas d’usage métier (ex. platform_campaign) — pour rapports de délivrance
  // même sans template versionné rattaché.
  useCase           String?         @map("use_case")
  channel           StrkCommChannel
  recipientId       String?         @map("recipient_id") @db.Uuid
  toAddress         String          @map("to_address") // e-mail ou numéro effectivement utilisé
  subject           String?
  body              String
  status            StrkCommStatus  @default(queued)
  // Le destinataire a explicitement refusé ce canal (COM-003) : le message
  // n'a jamais été transmis au fournisseur, distinct d'un échec technique.
  skippedOptOut     Boolean         @default(false) @map("skipped_opt_out")
  isCritical        Boolean         @default(false) @map("is_critical")
  providerMessageId String?         @unique @map("provider_message_id")
  errorMessage      String?         @map("error_message")
  requestedBy       String          @map("requested_by") @db.Uuid
  requestedAt       DateTime        @default(now()) @map("requested_at")
  sentAt            DateTime?       @map("sent_at")
  deliveredAt       DateTime?       @map("delivered_at")
  readAt            DateTime?       @map("read_at")
  failedAt          DateTime?       @map("failed_at")
  acknowledgedAt    DateTime?       @map("acknowledged_at")

  institution StrkInstitution?     @relation(fields: [institutionId], references: [id])
  template    StrkMessageTemplate? @relation(fields: [templateId], references: [id])
  recipient   StrkProfile?         @relation("CommunicationLogRecipient", fields: [recipientId], references: [id])
  requester   StrkProfile          @relation("CommunicationLogRequestedBy", fields: [requestedBy], references: [id])

  @@map("strk_communication_logs")
}

// ============================================================
// Documents & vérification (chap. 18, DOC-001 à 005)
// ============================================================

enum StrkDocumentType {
  enrollment_certificate // certificat de scolarité (élève)
  school_attestation // attestation distincte (présence / scolarité courte)
  payment_receipt // reçu de paiement (module Finance)
  invoice // facture PDF dédiée (FIN)
  report_card // EVA-006 : bulletin (moyennes/rangs par période, cf. StrkGradeComputation)
  // DOC-001 : relevé de notes — cumul de toutes les périodes d'une année
  // scolaire pour un élève (distinct du bulletin, qui porte sur une seule
  // période), et liste de classe — document administratif, pas rattaché à
  // un élève en particulier.
  transcript
  class_list
  // DOC-001 : carte d'élève (identité + matricule) — format carte (CR80).
  student_card
  /// Confirmation d'acceptation / dossier d'admission (PDF famille).
  admission_confirmation

  @@map("strk_document_type")
}

enum StrkDocumentStatus {
  generated
  revoked

  @@map("strk_document_status")
}

enum StrkDocumentFont {
  helvetica
  times
  courier

  @@map("strk_document_font")
}

// Un document généré (certificat, reçu...) avec QR de vérification publique.
// Une nouvelle génération pour la même clé logique (établissement + type +
// sujet) crée une nouvelle version — jamais d'écrasement (DOC-003), tout
// l'historique reste consultable et vérifiable, y compris après révocation.
model StrkDocument {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId     String             @map("institution_id") @db.Uuid
  type              StrkDocumentType
  // Clé logique du document : id élève pour un certificat de scolarité, id
  // paiement pour un reçu — regroupe les versions successives entre elles.
  subjectId         String             @map("subject_id") @db.Uuid
  version           Int                @default(1)
  status            StrkDocumentStatus @default(generated)
  title             String
  // Données utilisées pour générer le PDF, conservées pour pouvoir le
  // reproduire à l'identique sans dépendre du stockage S3 (DOC-005).
  dataSnapshot      Json               @map("data_snapshot")
  // Clé S3 si le stockage est configuré au moment de la génération ; sinon
  // le PDF est regénéré à la volée depuis `dataSnapshot` à chaque téléchargement.
  fileKey           String?            @map("file_key")
  verificationToken String             @unique @map("verification_token")
  generatedBy       String             @map("generated_by") @db.Uuid
  generatedAt       DateTime           @default(now()) @map("generated_at")
  revokedAt         DateTime?          @map("revoked_at")

  institution StrkInstitution @relation(fields: [institutionId], references: [id])
  generator   StrkProfile     @relation("DocumentGeneratedBy", fields: [generatedBy], references: [id])

  @@unique([institutionId, type, subjectId, version])
  @@map("strk_documents")
}

// DOC-002 : personnalisation par établissement de l'apparence des documents
// générés (logo, couleur d'accent, mention de pied de page, affichage de
// l'adresse). Configuration courante (pas d'historique de versions ici,
// contrairement à `StrkDocument` — c'est un réglage, pas une preuve émise).
// Volontairement limité : le bloc de vérification (QR, jeton, établissement,
// version, date — DOC-004) reste toujours généré par le système à un
// emplacement fixe, jamais personnalisable ni supprimable ("zone protégée")
// afin qu'aucune configuration d'établissement ne puisse compromettre
// l'authenticité vérifiable d'un document.
model StrkDocumentTemplate {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId    String           @map("institution_id") @db.Uuid
  type             StrkDocumentType
  // Clé S3 du logo (dossier "documents", périmètre établissement) — absent
  // si l'établissement n'a pas encore téléversé de logo ou si S3 n'est pas
  // configuré sur cette instance.
  logoKey          String?          @map("logo_key")
  // Couleur d'accent du titre/des séparateurs, format hexadécimal "#RRGGBB".
  accentColor      String?          @map("accent_color")
  footerText       String?          @map("footer_text")
  showAddress      Boolean          @default(true) @map("show_address")
  font             StrkDocumentFont @default(helvetica)
  // Filigrane discret (nom de l'établissement en diagonale, très clair,
  // derrière le texte) — dissuasif contre la reproduction non autorisée,
  // sans jamais recouvrir la zone protégée de vérification.
  watermarkEnabled Boolean          @default(false) @map("watermark_enabled")
  // Bloc de signature manuscrite (ex. "Le directeur" + nom) au-dessus de la
  // zone protégée — usage courant sur un certificat/une attestation.
  signatureLabel   String?          @map("signature_label")
  signatureName    String?          @map("signature_name")
  updatedBy        String           @map("updated_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  institution StrkInstitution @relation(fields: [institutionId], references: [id])
  updater     StrkProfile     @relation("DocumentTemplateUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([institutionId, type])
  @@map("strk_document_templates")
}

// ============================================================
// Support client (chap. 23/Lot 10, SAA-006) — jusqu'ici totalement absent :
// `CriticalAlertsCenter`/`LogsCenter` sont des tableaux de bord de
// supervision technique/sécurité (alertes système, journaux), pas un canal
// structuré pour qu'un établissement signale un problème et suive sa
// résolution. Modèle volontairement simple (ticket + fil de messages) —
// pas de champs de routage/SLA avancés non demandés par le cahier des
// charges (sujet, priorité, statut, historique).
// ============================================================

enum StrkSupportTicketPriority {
  low
  normal
  high
  urgent

  @@map("strk_support_ticket_priority")
}

enum StrkSupportTicketStatus {
  open
  in_progress
  waiting_on_customer
  resolved
  closed

  @@map("strk_support_ticket_status")
}

model StrkSupportTicket {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable : un admin global (SDCREATIV) peut ouvrir un ticket sans être
  // rattaché à un établissement particulier.
  institutionId String?                   @map("institution_id") @db.Uuid
  createdBy     String                    @map("created_by") @db.Uuid
  assignedTo    String?                   @map("assigned_to") @db.Uuid
  subject       String
  priority      StrkSupportTicketPriority @default(normal)
  status        StrkSupportTicketStatus   @default(open)
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  closedAt      DateTime?                 @map("closed_at")

  institution StrkInstitution?           @relation(fields: [institutionId], references: [id])
  creator     StrkProfile                @relation("SupportTicketCreatedBy", fields: [createdBy], references: [id])
  assignee    StrkProfile?               @relation("SupportTicketAssignedTo", fields: [assignedTo], references: [id])
  messages    StrkSupportTicketMessage[]

  @@map("strk_support_tickets")
}

model StrkSupportTicketMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String
  // Note d'équipe SDCREATIV, jamais visible du client qui a ouvert le ticket
  // — distinct d'une réponse adressée au demandeur.
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket StrkSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author StrkProfile       @relation("SupportTicketMessageAuthor", fields: [authorId], references: [id])

  @@map("strk_support_ticket_messages")
}

