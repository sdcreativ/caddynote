  academicYear  String?  @map("academic_year")
  status        String   @default("active") // active | cancelled | completed
  createdBy     String   @map("created_by") @db.Uuid
  feeScheduleId String?  @map("fee_schedule_id") @db.Uuid
  planTemplateId String? @map("plan_template_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution  StrkInstitution     @relation(fields: [institutionId], references: [id])
  student      StrkStudent         @relation(fields: [studentId], references: [id])
  creator      StrkProfile         @relation("PaymentPlanCreatedBy", fields: [createdBy], references: [id])
