# Variables lues par docker-compose.yml (stack conteneurisée).
# Copier vers `.env` à la racine. Ne pas confondre avec `server/.env`
# (secrets JWT/SMTP/Stripe de l'API, toujours requis).

WEB_PORT=8080
API_PORT=4000

# Postgres applicatif du compose (service caddynote-db).
# Port hôte 5433 : ne pas occuper 5432 (Postgres local / tests).
# `npm run dev` doit viser ce même port dans server/.env (DATABASE_URL …:5433/…)
# pour une seule base. Sinon : deux Postgres, deux jeux de données.
POSTGRES_USER=caddynote
POSTGRES_PASSWORD=caddynote
POSTGRES_DB=caddynote
POSTGRES_PORT=5433

# URL publique du site (SEO : canonical, Open Graph, sitemap).
# Ex. https://caddynote.com
VITE_SITE_URL=https://caddynote.com

# URL publique de l'API, injectée au *build* de l'image frontend (Vite).
# Depuis l'hôte : http://localhost:${API_PORT}
VITE_API_URL=http://localhost:4000

# Rôle du process API (lu par docker-compose.yml).
# `all` = HTTP + jobs (défaut). Pour isoler les jobs :
# CADDYNOTE_PROCESS_ROLE=api docker compose --profile split up -d
CADDYNOTE_PROCESS_ROLE=all

# --- Mailpit (optionnel, profile mail) ---
# docker compose -f docker-compose.yml -f docker-compose.mail.yml --profile mail up -d
# UI : http://localhost:${MAILPIT_UI_PORT:-8025}
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
