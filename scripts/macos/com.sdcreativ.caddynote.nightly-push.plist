<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent — push nocturne CaddyNote (03:00 heure locale).
  Installé typiquement dans ~/Library/LaunchAgents/
  Ne pas éditer la copie installée sans relancer launchctl.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.sdcreativ.caddynote.nightly-push</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/user/Sites/localhost/scolartrack/scripts/nightly-push-main.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/user/Sites/localhost/scolartrack</string>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>3</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <!-- Si le Mac était en veille à 03:00, lance au prochain réveil. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/user/Library/Logs/caddynote-nightly-push.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user/Library/Logs/caddynote-nightly-push.launchd.err.log</string>
  </dict>
</plist>
